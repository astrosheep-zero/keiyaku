{
  "name": "@astrosheep/keiyaku",
  "version": "4.5.12",
  "workspaces": [
    "plugins/*"
  ],
  "files": [
    "build"
  ],
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js"
    },
    "./task": {
      "types": "./build/src/task/public.d.ts",
      "import": "./build/src/task/public.js"
    },
    "./kanshi": {
      "types": "./build/src/kanshi/index.d.ts",
      "import": "./build/src/kanshi/index.js"
    },
    "./akuma": {
      "types": "./build/src/akuma/index.d.ts",
      "import": "./build/src/akuma/index.js"
    },
    "./plugin": {
      "types": "./build/src/plugin/public.d.ts",
      "import": "./build/src/plugin/public.js"
    }
  },
  "bin": {
    "keiyaku": "build/src/cli/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('build', { recursive: true, force: true })\" && tsc -p tsconfig.json && npm run build --workspace @astrosheep/keiyaku-plugin-square && node scripts/copy-integrations.js && node scripts/build-windows-launcher.js && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('build/src/cli/index.js', 0o755)\"",
    "prepack": "node scripts/verify-package.js",
    "postpack": "node scripts/verify-package.js",
    "harness:version": "node scripts/update-harness-version.js",
    "review:model-impact": "node --import tsx scripts/model-change-impact.ts",
    "format": "prettier --write --print-width 120 \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check --print-width 120 \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "eslint src scripts tests",
    "lint:tests": "eslint tests",
    "test": "node scripts/test-entry.mjs",
    "test:all": "npm run format:check && npm run build && npm run test:architecture && npm run test:maintainability && npm run test:reachability && npm run test:parallel",
    "test:architecture": "node --import tsx scripts/check-architecture.ts",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "node scripts/run-tests.mjs tests/packaged-cli.e2e.ts",
    "test:local": "node scripts/run-tests.mjs --suite local",
    "test:integration": "node scripts/run-tests.mjs --suite integration --test-skip-pattern=recent.Akuma.page.prunes.old.custody.bounds",
    "test:parallel": "node scripts/run-tests.mjs --suite pure --no-test-isolation --test-concurrency=1 && node scripts/run-tests.mjs --suite isolated --test-concurrency=8 --test-skip-pattern=recent.Akuma.page.prunes.old.custody.bounds",
    "test:maintainability": "node scripts/check-maintainability.js",
    "test:focused": "node scripts/run-tests.mjs",
    "test:focused:serial": "node scripts/run-tests.mjs --test-concurrency=1",
    "test:reachability": "knip --include files,dependencies,unlisted,unresolved,duplicates",
    "test:stress": "node scripts/run-tests.mjs --test-name-pattern=recent.Akuma.page.prunes.old.custody.bounds tests/facade-fleet.test.ts",
    "test:typecheck": "tsc -p tsconfig.json --noEmit && npm run test:typecheck:aux",
    "test:typecheck:aux": "npm run test:typecheck:scoped-tests && npm run test:typecheck:scripts",
    "test:typecheck:scoped-tests": "tsc -p tsconfig.tests.json",
    "test:typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test:quick": "npm run test:parallel"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.0.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "knip": "^6.31.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@opencode-ai/sdk": "1.18.3",
    "cross-spawn": "^7.0.6",
    "diff": "^8.0.4",
    "yaml": "^2.9.0",
    "zod": "^4.5.2"
  },
  "description": "Keiyaku is an agent-facing contract workflow.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./build/integrations/pi/keiyaku.ts"
    ],
    "skills": [
      "./build/integrations/marketplace/plugins/keiyaku/skills"
    ]
  },
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrosheep-zero/keiyaku.git"
  },
  "bugs": {
    "url": "https://github.com/astrosheep-zero/keiyaku/issues"
  },
  "homepage": "https://github.com/astrosheep-zero/keiyaku#readme"
}
